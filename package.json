{
  "name": "az-discord-server-bot",
  "version": "1.0.0",
  "description": "Azerbaijani Discord server setup bot - creates channels, roles, and role-select menus",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "deploy": "node deploy-commands.js",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dashboard:start": "npm run start --prefix dashboard",
    "dev": "concurrently \"npm run start\" \"npm run dashboard:dev\""
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0"
  }
}
